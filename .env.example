# Exemplo de ambiente. Copie para .env e preencha localmente.
# Não use senhas, chaves nem URLs reais neste arquivo.
# No Railway, defina estas variáveis no serviço. Não envie o arquivo .env.

# development | production
# Produção: production
DJANGO_ENVIRONMENT=

# true | false
# Produção: false. Se omitido e DJANGO_ENVIRONMENT=production, o padrão é false.
DJANGO_DEBUG=

# Obrigatória em produção ou com DEBUG=false.
# Gere uma chave forte no ambiente. Não cole a chave real aqui.
DJANGO_SECRET_KEY=

# Lista separada por vírgulas.
# Produção: domínio público do serviço, sem esquema.
# Exemplo de formato: seu-servico.up.railway.app
DJANGO_ALLOWED_HOSTS=

# Origens HTTPS confiáveis para o CSRF, separadas por vírgulas.
# Produção: https:// seguido do mesmo domínio usado em DJANGO_ALLOWED_HOSTS.
# Exemplo de formato: https://seu-servico.up.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=

# Desenvolvimento: omitir → SQLite (db.sqlite3)
# Produção: obrigatória. Use a URL PostgreSQL fornecida pelo Railway.
# Não cole usuário, senha nem host reais aqui.
DATABASE_URL=

# Opcional. PostgreSQL padrão 60. SQLite permanece 0 se omitido.
DJANGO_CONN_MAX_AGE=

# Opcional. Ex.: require  (não se aplica ao SQLite)
DJANGO_DATABASE_SSLMODE=

# Opcional. YYYY-MM-DD  (SAIDA automática de venda)
DJANGO_ESTOQUE_DATA_CORTE=
